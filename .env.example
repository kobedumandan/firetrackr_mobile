# Backend base URL (the ngrok tunnel to the FastAPI server, or a LAN address
# like http://192.168.1.10:8000). No trailing slash needed.
# Restart with `npx expo start -c` after changing it.
EXPO_PUBLIC_API_BASE_URL=https://deacon-overcook-heftiness.ngrok-free.dev

# UUID from Expo project settings (public app configuration, not a secret).
# Required for remote dispatch alerts. Native Android push also needs
# google-services.json and FCM V1 credentials uploaded to the same Expo project.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional path to an EAS file environment variable for Android Firebase config.
# Otherwise app.config.js looks for ./google-services.json.
# GOOGLE_SERVICES_JSON=
