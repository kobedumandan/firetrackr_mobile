{
  "expo": {
    "name": "FireTrackr",
    "slug": "firetrackr-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0c0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bfp.firetrackr",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bfp.firetrackr",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {},
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "FireTrackr needs access to your photos so you can attach scene photographs to an incident report.",
          "cameraPermission": "FireTrackr needs camera access so you can take scene photographs for an incident report.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FireTrackr shares your location with the command center while you are on duty, including standby and active dispatches.",
          "locationAlwaysAndWhenInUsePermission": "FireTrackr shares your location while on duty even with the screen off: every 30 seconds on standby and more often during a dispatch. Sharing stops when you are off duty.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff4d1a"
        }
      ]
    ],
    "androidNavigationBar": {
      "backgroundColor": "#0a0c0f",
      "barStyle": "light-content"
    },
    "extra": {
      "eas": {
        "projectId": "7de90dd9-420d-40fa-b8b0-772b9a698fbf"
      }
    },
    "owner": "kobeduu"
  }
}
